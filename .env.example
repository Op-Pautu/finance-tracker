# ── Supabase ──────────────────────────────────────────────────
# Project Settings → API Keys in the Supabase dashboard.
# The NEXT_PUBLIC_* values are safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Used by Server Actions / route handlers for the site origin (OAuth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cron
CRON_SECRET=
